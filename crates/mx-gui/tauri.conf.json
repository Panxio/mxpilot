{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mx-gui",
  "version": "0.1.1",
  "identifier": "com.mxoptions.gui",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build",
    "frontendDist": "./ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MX Options Linux",
        "width": 960,
        "height": 620,
        "minWidth": 840,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; script-src-attr 'none'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; worker-src 'none'; media-src 'none'; manifest-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
