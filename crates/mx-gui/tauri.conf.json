{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mx-gui",
  "version": "0.1.0",
  "identifier": "com.mxoptions.gui",
  "build": {
    "frontendDist": "./ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MX Options Linux",
        "width": 760,
        "height": 540,
        "resizable": false,
        "fullscreen": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
