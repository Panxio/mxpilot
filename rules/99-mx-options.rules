# Reglas udev para MX Options Linux
# Otorga permisos de acceso seguro al usuario de escritorio (sin root / sin sudo)
# para dispositivos Logitech HIDRAW (USB y Bluetooth) y el nodo uinput.

# 1. Logitech HIDRAW sobre receptores USB (Unifying / Bolt / Cable)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# 2. Logitech HIDRAW sobre Bluetooth BLE (dispositivos bajo /devices/virtual/misc/uhid/)
SUBSYSTEM=="hidraw", KERNELS=="*:046D:*", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="hidraw", ENV{HID_ID}=="*:0000046D:*", MODE="0660", GROUP="plugdev", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*046D*", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# 3. Emulador de teclado y mouse virtual uinput
KERNEL=="uinput", SUBSYSTEM=="misc", MODE="0660", GROUP="input", TAG+="uaccess"
