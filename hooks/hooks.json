{
  "contexto-160k-200k": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "CTX_MODO=invocation ~/.gemini/config/hooks/hook-contexto-agy.sh",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "CTX_MODO=tool CTX_BLOQUEA=0 ~/.gemini/config/hooks/hook-contexto-agy.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
