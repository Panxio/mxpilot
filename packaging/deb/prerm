#!/bin/sh
# prerm — mx-options (Debian)
# Invariante Zero Dead Buttons en desinstalación
set -e

graceful_stop() {
    if command -v pkill >/dev/null 2>&1; then
        if pkill -x -TERM mx-daemon 2>/dev/null; then
            # Esperar hasta 2.5 s a que los procesos del daemon finalicen y desactiven el divert
            i=0
            while pkill -x -0 mx-daemon 2>/dev/null && [ "$i" -lt 25 ]; do
                sleep 0.1
                i=$((i + 1))
            done
            # Si tras 2.5 s no terminó, señal de interrupción forzosa
            if pkill -x -0 mx-daemon 2>/dev/null; then
                pkill -x -KILL mx-daemon 2>/dev/null || true
            fi
        fi
    fi
    return 0
}

case "$1" in
    remove|purge|deconfigure)
        graceful_stop || true
        ;;
    upgrade|failed-upgrade)
        # En actualización no se interrumpe el hardware
        ;;
    *)
        ;;
esac

exit 0
